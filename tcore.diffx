     SetDisplayId(GetNativeDisplayId());
+    //SetNativeDisplayId(GetNativeDisplayId());
+
+    //SetDisplayId(demorphId);
+    //SetNativeDisplayId(demorphId);
+#else
+    SetDisplayId(GetNativeDisplayId());
+#endif
 }
 
