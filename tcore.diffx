diff --git a/src/server/game/Entities/Unit/Unit.cpp b/src/server/game/Entities/Unit/Unit.cpp
index 82950df2a7..dff01bee29 100644
--- a/src/server/game/Entities/Unit/Unit.cpp
+++ b/src/server/game/Entities/Unit/Unit.cpp
@@ -1208,6 +1208,25 @@ void Unit::CalculateSpellDamageTaken(SpellNonMeleeDamage* damageInfo, int32 dama
     // Script Hook For CalculateSpellDamageTaken -- Allow scripts to change the Damage post class mitigation calculations
     sScriptMgr->ModifySpellDamageTaken(damageInfo->target, damageInfo->attacker, damage);
 
+#ifdef USE_CUSTOM_CHANGES
+    // Buff spells
+    // Buff lava burst
+    if (spellInfo->Id == 60043)
+        damage *= 2;
+    // Buff earth shock
+    else if (spellInfo->Id == 49231)
+        damage *= 3;
+    // Buff pyroblast
+    else if (spellInfo->Id == 42891)
+        damage *= 1.4;
+    // Buff CL / frostbolt
+    else if (spellInfo->Id == 49271 || spellInfo->Id == 42842)
+        damage *= 1.2;
+    // Buff arcane barrage
+    else if (spellInfo->Id == 44425)
+        damage *= 100;
+
+#endif
     // Calculate absorb resist
     if (damage < 0)
         damage = 0;
@@ -3467,7 +3486,16 @@ void Unit::ProcessTerrainStatusUpdate(ZLiquidStatus /*oldLiquidStatus*/, Optiona
 
